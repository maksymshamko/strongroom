# spec 004 §2.2 — ONE .env at the monorepo root, read by three consumers:
#   • apps/api   at run time (dotenv, resolved upward to this file)
#   • apps/web   at BUILD time for NEXT_PUBLIC_*, run time for the rest
#   • docker compose --env-file .env
#
# Copy to .env and fill in. Everything marked "optional" has a working local
# fallback, so a fresh clone runs end to end with none of them set.

# Which deployment this is. Also passed as ARG ENV to both Docker builds.
ENV=development

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local:      docker compose -f docker-compose.dev.yml up -d   → port 5433
# Supabase:   Project settings → Database → Connection string (pooled).
DATABASE_URL="postgresql://dataroom:dataroom@127.0.0.1:5433/dataroom?schema=public"
# Supabase only: the direct (non-pooled) URL, used for migrations.
DIRECT_URL=""

# Used by the API test suite. Must be a DIFFERENT database — the suite truncates it.
TEST_DATABASE_URL="postgresql://dataroom:dataroom@127.0.0.1:5433/dataroom_test?schema=public"

# ---------------------------------------------------------------------------
# Sessions and URLs (required)
# ---------------------------------------------------------------------------
# 32+ chars. Rotating it signs everyone out.
JWT_SECRET="change-me-to-at-least-32-random-characters"

# Local
WEB_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Production (one origin behind nginx, so the API path is relative — §3):
# WEB_URL="https://strongroom.shamko.me"
# API_PUBLIC_URL="https://strongroom.shamko.me/api/v1"
# NEXT_PUBLIC_API_URL="/api/v1"

API_PORT=3001

# ---------------------------------------------------------------------------
# Blob storage — optional
# ---------------------------------------------------------------------------
# Unset ⇒ the FileStorage port binds to a local adapter that serves signed URLs
# from the API itself, so the real upload handshake works with no cloud account.
#
# To use real Supabase Storage, both of these must be true or uploads fail with
# "new row violates row-level security policy":
#   • the bucket below exists (Storage → New bucket, private)
#   • the key below is the *service_role* secret from Project Settings → API
#     keys (or an `sb_secret_…` key). The anon/publishable key on that same page
#     is subject to RLS and cannot write objects.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="dataroom"

# ---------------------------------------------------------------------------
# Email — optional
# ---------------------------------------------------------------------------
# Unset ⇒ share invites go to an in-memory mailer and are logged, not sent.
RESEND_API_KEY=""
MAIL_FROM="Strongroom <noreply@strongroom.shamko.me>"

# ---------------------------------------------------------------------------
# Google OAuth — optional
# ---------------------------------------------------------------------------
# Unset ⇒ the Google button is hidden and email/password is the only route in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# ---------------------------------------------------------------------------
# Sentry — optional (spec 004 §4). One project, both apps, split by `service` tag.
# ---------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="1.0"

# ---------------------------------------------------------------------------
# PostHog — optional (spec 004 §5). EU cloud; events and identify only.
# ---------------------------------------------------------------------------
POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Seed the demo account on container start. Never enable in production.
SEED_ON_START=false
